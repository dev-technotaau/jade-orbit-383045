# =============================================================
# WhatsApp Cloud Module — frontend
# =============================================================
# Copy to `.env` and fill in.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time —
# never put a secret in one. Keys without the prefix stay server-side and are
# read by the BFF routes under src/app/api/.

# ── API endpoints ───────────────────────────────────────────
# Public API base, used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Socket.IO origin.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# This app's own origin (absolute URLs, metadataBase).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only: the URL the BFF proxies to. Never exposed to the browser,
# so it can be an internal hostname.
BACKEND_INTERNAL_URL=http://localhost:5000/api/v1

# Must match the backend's BFF_SECRET. Proves a request came from our own
# BFF rather than a browser, so the backend can bypass CSRF for proxied calls.
BFF_SECRET=

# ── Branding ────────────────────────────────────────────────
# Wordmark shown in the sidebar and on the unlock page. Keep in sync with the
# backend's BRAND_NAME.
NEXT_PUBLIC_BRAND_NAME=TechnoTaau

# Path to a logo image in frontend/public. Empty falls back to the
# BRAND_NAME wordmark.
NEXT_PUBLIC_BRAND_LOGO=/logo.svg

# Display label for the single operator.
NEXT_PUBLIC_OPERATOR_LABEL=operator

# ── Optional: R2 public bucket ──────────────────────────────
# Only needed if you serve media straight from a public R2 domain rather than
# through the backend. When set it is added to next/image's remotePatterns and
# to the CSP img-src. Match the backend's R2_PUBLIC_URL.
NEXT_PUBLIC_R2_PUBLIC_URL=

# Shown as the support contact where the UI needs one. Optional.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Absolute lifetime of the unlock cookie, in hours (default 12).
# Absolute, not idle-based — operators reading a long thread are not signed out.
SESSION_MAX_AGE_HOURS=12

# Largest file the UI will attempt to upload, in megabytes.
# Uploads travel through the Next.js BFF proxy, which buffers the whole body;
# serverless platforms cap that (Vercel: 4.5 MB). Raise this only on a
# self-hosted deployment without that cap — the backend's own limit is 16 MB.
NEXT_PUBLIC_MAX_UPLOAD_MB=4

# Cloudflare Turnstile site key — the public half of the bot check on /unlock.
# REQUIRED: without it the challenge cannot render and the API rejects sign-in.
# Local development test key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
