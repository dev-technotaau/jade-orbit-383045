// ============================================================================
// ARTICLE SYSTEM — literal Prisma, copy-paste ready
// ============================================================================
// Companion to ../../article-system-implementation-plan.md (Phase 1 / T1.x).
// Append to backend/prisma/schema.prisma after OffPlatformResume (line ~5051),
// under a 3-line `// ====` banner matching the EMAIL SYSTEM block.
//
// ⚠️ THIS IS A FRAGMENT, NOT A STANDALONE SCHEMA. Opened on its own, the Prisma
// extension reports `Type "User" is neither a built-in type, nor refers to
// another model…` on every User relation. That is expected and correct — `User`
// lives in schema.prisma, and these errors disappear the moment the block is
// appended there. Do not "fix" them by stubbing a User model here.
//
// Conventions verified against the existing schema:
//   · No @@map / @map anywhere — model name == table name, PascalCase
//   · uuid ids (129 uuid vs 10 cuid in the schema); `///` doc comments on models
//   · Enums declared immediately above the models that use them
//   · Author-ish FKs are always onDelete: SetNull; child rows are Cascade
//   · Aggressive indexing, including redundant single-column indexes
// ============================================================================

enum ArticleKind {
  HELP
  NEWS
  BLOG
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  DELETED // soft-delete is a terminal STATUS, matching ReviewStatus (schema:3486)
}

enum ArticleCommentStatus {
  PENDING // default — pre-moderation, unlike CompanyReview which defaults APPROVED
  APPROVED
  FLAGGED
  REJECTED
  DELETED
}

enum ArticleAccessLevel {
  PUBLIC
  REGISTERED
  PLAN_GATED
  LEAD_GATED
}

enum ArticleAssignmentRole {
  AUTHOR
  EDITOR
  REVIEWER
  TRANSLATOR
}

/// Content-type registry (D11) — a 4th type is a ROW, not a migration + enum + code change.
/// Seeded with help / news / blog.
model ArticleType {
  id                  String      @id @default(uuid())
  slug                String      @unique
  kind                ArticleKind
  label               String
  routePrefix         String // "/blog", "/news", "/help"
  jsonLdType          String // "BlogPosting" | "NewsArticle" | "Article"
  enabledFields       String[]    @default([])
  includeInFeeds      Boolean     @default(true)
  participatesInShard Boolean     @default(true)
  workflowProfile     String      @default("standard")
  displayOrder        Int         @default(0)
  isActive            Boolean     @default(true)

  // ── SEO patterns (D15) ────────────────────────────────────────────────────
  // Token-interpolated templates that produce every non-pinned SEO field for
  // articles of this type. Editable in super-admin, so retuning titles sitewide
  // is a form submit + recompute, not a deploy. Tokens: {{title}} {{excerpt}}
  // {{category}} {{author}} {{date}} {{siteName}} {{readMinutes}}
  metaTitlePattern       String? // e.g. "{{title}} | {{siteName}}"
  metaDescriptionPattern String?
  ogTitlePattern         String?
  breadcrumbRootLabel    String? // "Blog" / "News" / "Help Centre"
  defaultNoindex         Boolean @default(false)
  defaultChangefreq      String? // sitemap hint
  defaultPriority        Float? // sitemap hint

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive, displayOrder])
}

/// Taxonomy. NOTE the GLOBAL slug unique (plan G-1): the frontend routes ALL
/// category hubs under /blog/category/{slug} regardless of kind, so a
/// kind-scoped key would put two different pages at one URL. `kind` is a
/// nullable display hint only.
model ArticleCategory {
  id              String       @id @default(uuid())
  slug            String       @unique
  kind            ArticleKind?
  label           String
  description     String?
  iconKey         String?
  metaTitle       String?
  metaDescription String?
  // Category had the meta STRINGS but no pin record, so it would rot in exactly
  // the way D15 exists to prevent — a human edit was indistinguishable from a
  // derived value. Hub OG cards were also missing.
  ogImageUrl      String?
  noindex         Boolean      @default(false)
  seoOverrides    String[]     @default([])
  heroH1          String?
  heroSubtitle    String?
  faqCategory     String? // bridges to FaqCategory in frontend/src/data/faqs/types.ts
  displayOrder    Int          @default(0)
  isFeatured      Boolean      @default(false)
  isPublic        Boolean      @default(true)
  articleCount    Int          @default(0) // denormalised; reconciled nightly
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  articles Article[]

  @@index([slug])
  @@index([kind, isPublic, displayOrder])
}

/// First-class tag entity — /blog/tag/[slug] hubs need a canonical label and a
/// published count, which a bare String[] cannot provide.
model ArticleTag {
  id           String   @id @default(uuid())
  slug         String   @unique
  label        String
  description  String?
  articleCount Int      @default(0)
  isPublic     Boolean  @default(true)

  // Hub SEO (D15). /blog/tag/{slug} is an INDEXABLE hub, so it needs the same
  // derive-by-default + pin-on-edit treatment as an article. Patterns live as
  // versioned constants in article-seo.service.ts, not as columns here.
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  noindex         Boolean  @default(false)
  seoOverrides    String[] @default([])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articleLinks ArticleTagOnArticle[]

  @@index([slug])
  @@index([isPublic, articleCount])
}

/// Explicit join. Article.tags String[] is a denormalised MIRROR kept in sync in
/// the same transaction — the array powers the GIN-indexed filter, this table
/// powers counts, rename and merge.
model ArticleTagOnArticle {
  articleId String
  tagId     String
  createdAt DateTime @default(now())

  article Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/// Author entity — /blog/author/[slug], AuthorBox bio + socials, and E-A-T
/// structured data all need this. `userId` is optional: a guest columnist has no
/// platform account.
model ArticleAuthor {
  id          String   @id @default(uuid())
  slug        String   @unique
  displayName String
  title       String?
  bio         String?
  avatarUrl   String?
  socials     Json? // { linkedin, x, github, website } — feeds sameAs in JSON-LD
  styleNotes  String? // shown read-only in the editor sidebar when this author is selected
  userId      String?
  isActive    Boolean  @default(true)

  // Hub SEO (D15). The author hub is the E-E-A-T destination `article:author`
  // resolves to, so it is indexable and needs real metadata.
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  noindex         Boolean  @default(false)
  seoOverrides    String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?     @relation("ArticleAuthorUser", fields: [userId], references: [id], onDelete: SetNull)
  articles Article[]
  bylines  ArticleAuthorOnArticle[]

  @@index([slug])
  @@index([userId])
}

/// The content row.
model Article {
  id                 String        @id @default(uuid())
  kind               ArticleKind
  typeSlug           String        @default("blog")
  slug               String
  locale             String        @default("en") // D5: only "en" is written at v1
  translationGroupId String?
  status             ArticleStatus @default(DRAFT)

  title             String
  excerpt           String?
  // D10 (revised): the SANITISED bodyHtml is the source of truth and the render
  // source. bodyJson is written verbatim from the same editor instance in the
  // same request as a forward-compat artefact and is NEVER read back — not to
  // render, not to re-hydrate the editor. Reading it back would resurrect
  // content the sanitiser stripped.
  bodyJson          Json?
  bodyHtml          String? // sanitised; everything below is parsed from THIS

  // D17 — WORKING COPY. While status is PUBLISHED or ARCHIVED, every body and
  // metadata write (manual AND ?mode=autosave) lands HERE, never on the live
  // columns above. Public reads, derived values, contentUpdatedAt, the
  // ArticleCorrection trigger and refCount all read the LIVE columns.
  // Without this, a 2s-idle autosave mutates the exact row the public page
  // serves — the public endpoint's predicate is status:'PUBLISHED', which does
  // not change while someone is editing.
  draftTitle              String?
  draftExcerpt            String?
  draftBodyHtml           String?
  draftBodyJson           Json?
  draftCoverImagePublicId String?
  draftCoverImageUrl      String?
  draftCoverImageAlt      String?
  draftUpdatedAt          DateTime?
  draftUpdatedById        String?
  hasUnpublishedChanges   Boolean   @default(false)
  bodyText          String? // derived — search + reading time
  bodyFormatVersion Int     @default(1)
  wordCount         Int     @default(0)
  readMinutes       Int     @default(0)

  // Cover image — Cloudinary (D13). `coverImagePublicId` is the delete/transform
  // handle; `coverImageUrl` is the secure delivery URL.
  coverImagePublicId String?
  coverImageUrl      String?
  coverImageAlt      String?
  coverImageWidth    Int? // required at upload — dimensionless images are rejected (CLS)
  coverImageHeight   Int?
  // Shape is a CONTRACT, not free-form:
  //   { card:{url,w:1280,h:720}, hero:{url,w:1920,h:1080},
  //     social:{url,w:1200,h:630}, square:{url,w:600,h:600}, blur:{dataUri} }
  // Produced by the NEW `article` profile in image-processing.worker.ts — the
  // existing profile emits 100/200/400 SQUARES and would be useless here.
  coverImageVariants Json?
  // Focal point from the cropper → Cloudinary `c_fill,g_xy_center`.
  // When null, transforms use `g_auto`, never a blind centre crop.
  coverFocalX        Float?
  coverFocalY        Float?

  // ── SEO ─────────────────────────────────────────────────────────────────
  // D15: every field here is DERIVED on each save unless its name appears in
  // `seoOverrides`, which is the record of what a human deliberately pinned.
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String? // self-canonical when null
  keywords        String[] @default([])
  focusKeyword    String? // drives the on-page SEO score
  noindex         Boolean  @default(false)
  nofollow        Boolean  @default(false)
  noarchive       Boolean  @default(false)
  maxSnippet      Int? // robots max-snippet; null = unset
  maxImagePreview String? // "none" | "standard" | "large"
  maxVideoPreview Int?

  // Open Graph / Twitter. Null → fall back to metaTitle/metaDescription/cover,
  // which is itself the derived value, so the fallback chain never dead-ends.
  ogTitle          String?
  ogDescription    String?
  ogType           String? @default("article")
  ogImageUrl       String? // auto-generated card unless pinned
  twitterCard      String? @default("summary_large_image")
  twitterTitle     String?
  twitterDescription String?
  twitterImageUrl  String?

  seoOverrides String[] @default([]) // D15 — field names pinned by a human
  seoRulesVersion Int    @default(1) // recompute trigger when SEO_RULES_VERSION bumps
  seoScore     Int? // 0-100, computed by the publish checklist
  schemaOverride Json? // hand-authored JSON-LD merged over the generated graph

  accessLevel     ArticleAccessLevel @default(PUBLIC) // D12
  requiredFeature String?
  teaserBlocks    Int                @default(2)

  categoryId String?
  authorId   String?
  tags       String[] @default([]) // denormalised mirror of ArticleTagOnArticle

  // Bridge to the PRE-EXISTING static FAQ corpus (frontend/src/data/faqs/).
  // Distinct from the per-article FAQ blocks below — same word, different
  // feature. Do not conflate them.
  faqCategory     String?
  faqAudiences    String[] @default([])
  faqPageContexts String[] @default([])
  relatedFaqIds   String[] @default([])

  // Review outcome. The transition matrix distinguishes DRAFT from
  // "DRAFT (approved)" — publish and schedule are gated on the latter — and
  // without these columns the two states are indistinguishable.
  // Cleared on any subsequent body edit: approval is of a specific version.
  approvedAt   DateTime?
  approvedById String?

  // A scheduled publish that fails leaves a trace the EDITOR can read; the
  // Prometheus "publish lag" alert is ops-facing and nobody in the CMS sees it.
  publishAttemptedAt DateTime?
  publishError       String?

  tocEnabled Boolean @default(true) // per-article ToC toggle; heading-level opt-out is class="article-toc-skip"
  // A template is just an Article — reuses the whole editor and the duplicate
  // path instead of a parallel model. Never published, never in a sitemap.
  isTemplate Boolean @default(false)

  // Editorial promotion. `isFeatured` exists on ArticleCategory but did NOT
  // exist here, while the plan's FeaturedCarousel (§9a) selects on it.
  isFeatured   Boolean   @default(false)
  featuredAt   DateTime? // for "most recently featured first" ordering
  featuredRank Int? // manual ordering within the featured set

  // D16 — How-To envelope. The steps themselves are ArticleHowToStep rows.
  // Emission gate is `howToEnabled && steps.length >= 2`.
  howToEnabled   Boolean  @default(false)
  howToTotalTime String? // ISO-8601 duration, e.g. "PT15M"
  howToTools     String[] @default([])
  howToSupplies  String[] @default([])
  relatedArticleIds String[] @default([]) // editor-curated; falls back to category → tags → recent

  conversionCount Int       @default(0) // denormalised, mirrors WaConversion's pattern
  views           Int       @default(0)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  commentCount    Int       @default(0)
  lastCommentAt   DateTime?
  commentsEnabled Boolean   @default(true)

  version            Int       @default(1)
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  contentUpdatedAt   DateTime? // G-3 — feeds dateModified. NEVER use updatedAt for that.
  archivedAt         DateTime?
  reviewIntervalDays Int?
  nextReviewAt       DateTime?
  lastReviewedAt     DateTime?
  lastReviewedById   String?
  ownerUserId        String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt // G-2 — the 5-min view flush uses a raw UPDATE that does NOT touch this

  category  ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author    ArticleAuthor?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("ArticleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  owner     User?            @relation("ArticleOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  revisions    ArticleRevision[]
  comments     ArticleComment[]
  tagLinks     ArticleTagOnArticle[]
  assignments  ArticleAssignment[]
  workflow     ArticleWorkflowEvent[]
  viewsDaily   ArticleViewDaily[]
  outLinks     ArticleLink[]         @relation("ArticleOutLinks")
  inLinks      ArticleLink[]         @relation("ArticleInLinks")
  assets       ArticleAsset[]
  helpfulVotes ArticleHelpfulVote[]
  faqs         ArticleFaq[] // D16
  howToSteps   ArticleHowToStep[] // D16
  conversions  ArticleConversion[]
  bookmarks    ArticleBookmark[]
  leads        ArticleLead[] // D12 LEAD_GATED
  corrections  ArticleCorrection[]
  bylines      ArticleAuthorOnArticle[]
  shareTokens  ArticleShareToken[]
  locks        ArticleLock[]
  notes        ArticleNote[]

  @@unique([kind, slug, locale], name: "uq_article_kind_slug_locale")
  @@unique([translationGroupId, locale], name: "uq_article_group_locale") // G-4
  @@index([slug])
  @@index([kind, status, publishedAt])
  @@index([status, scheduledPublishAt])
  @@index([categoryId, status, publishedAt])
  @@index([authorId, status, publishedAt])
  @@index([archivedAt])
  @@index([nextReviewAt])
  @@index([typeSlug])
  @@index([createdAt])
  // Hand-written in migration.sql, invisible to Prisma (plan G-6):
  //   CREATE INDEX article_tags_gin      ON "Article" USING GIN ("tags");
  //   CREATE INDEX article_keywords_gin  ON "Article" USING GIN ("keywords");
  //   CREATE INDEX article_faqctx_gin    ON "Article" USING GIN ("faqPageContexts");
}

/// Immutable version snapshot — cloned from EmailTemplateVersion (schema:4470).
/// The audit log CANNOT serve as version history: audit() redacts keys named
/// body/text/comment/note/message/caption/answer/question.
/// Cut on manual save / status transition / 10-min accumulation only (R14),
/// content-hash deduped, retained 100 per article + all published versions.
model ArticleRevision {
  id          String   @id @default(uuid())
  articleId   String
  version     Int
  title       String
  excerpt     String?
  bodyJson    Json?
  bodyHtml    String?
  contentHash String
  note        String?
  createdBy   String? // bare String, matching EmailTemplateVersion
  createdAt   DateTime @default(now())

  // A revision must capture EVERYTHING that renders, or "restore" silently
  // reverts the body while leaving the cover, the SEO fields and the D16 FAQ /
  // How-To blocks at their current values — producing a version that never
  // existed. These snapshot the whole renderable state as JSON.
  coverSnapshot Json? // publicId, url, alt, w/h, focal point
  seoSnapshot   Json? // meta/OG/twitter/robots/canonical + seoOverrides
  faqSnapshot   Json? // ordered [{question, answerHtml, imageAssetId}]
  howToSnapshot Json? // {enabled, totalTime, tools[], supplies[], steps[]}

  // Retention is "keep the last 100 + ALL PUBLISHED VERSIONS FOREVER", which is
  // unimplementable without knowing which ones were published. Set at publish
  // and at publish-changes (D17 promote); the prune job never deletes these.
  wasPublished Boolean   @default(false)
  publishedAt  DateTime?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId, version])
  @@index([contentHash])
  @@index([articleId, wasPublished]) // the retention query
}

/// 301 history. Written on EVERY slug change AND every kind change (R15) —
/// the URL prefix is derived from kind, so reclassification moves the URL.
/// Taxonomy hub redirects. ArticleSlugRedirect cannot express these — its key
/// is [fromKind, fromSlug] with ArticleKind-typed columns and an articleId, so
/// it has no way to represent /blog/category/x → /blog/category/y.
/// Written on every category/tag/author slug change and on a tag merge.
enum ArticleTaxonomyKind {
  CATEGORY
  TAG
  AUTHOR
}

model ArticleTaxonomyRedirect {
  id         String              @id @default(uuid())
  entityType ArticleTaxonomyKind
  fromSlug   String
  toSlug     String
  hitCount   Int                 @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime            @default(now())

  @@unique([entityType, fromSlug])
  @@index([hitCount])
}

model ArticleSlugRedirect {
  id        String      @id @default(uuid())
  fromKind  ArticleKind
  fromSlug  String
  toKind    ArticleKind
  toSlug    String
  articleId String
  // Redirect usage, flushed from Redis `article:redirhits:{id}` by the
  // generalised view-counter worker — NEVER incremented synchronously on the
  // 301, which is edge-served and would not reach the controller anyway.
  hitCount  Int         @default(0)
  lastHitAt DateTime?
  createdAt DateTime    @default(now())

  @@unique([fromKind, fromSlug])
  @@index([articleId])
  @@index([hitCount])
}

/// Comment + exactly ONE reply level (comment → reply). The service re-parents a
/// reply-to-a-reply onto its root and records replyToName so that is visible.
model ArticleComment {
  id        String               @id @default(uuid())
  articleId String
  parentId  String?
  rootId    String?
  depth     Int                  @default(0)
  replyToName String?
  status    ArticleCommentStatus @default(PENDING)

  body String @db.Text

  userId     String?
  guestName  String?
  guestEmail String? // never rendered in any public payload

  // Staff response. `isStaff` renders the official badge; `staffRole` is the
  // label shown next to it ("Hire Adda Team", "Editor", "Support"). A staff
  // reply skips the moderation queue (author is already trusted) and is the
  // one comment kind that may be pinned to the top of its thread.
  isStaff   Boolean @default(false)
  staffRole String?
  isPinned  Boolean @default(false)
  pinnedAt  DateTime?
  pinnedBy  String?

  ipAddress       String? // forensics — purged after 90 days
  userAgent       String?
  fingerprintHash String?

  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)
  reportedCount   Int @default(0)
  replyCount      Int @default(0)

  moderationReason String?
  moderatedBy      String?
  moderatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent  ArticleComment?  @relation("ArticleCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ArticleComment[] @relation("ArticleCommentReplies")
  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  votes   ArticleCommentVote[]
  reports ArticleCommentReport[]

  // NOTE: parent is onDelete: Cascade, so a hard delete destroys the reply
  // subtree. There is NO hard-delete code path anywhere — status DELETED only.
  @@index([articleId, status, createdAt])
  @@index([rootId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([status, createdAt])
  @@index([fingerprintHash])
  // Moderation queue's default view: unanswered threads, most-reported first.
  @@index([status, reportedCount])
  // Pinned staff replies surface first within a thread.
  @@index([articleId, isPinned])
}

/// Idempotent vote. Dual uniques so a guest votes once too (CompanyReviewVote:3577).
/// fingerprintHash MUST be day-bucketed (plan §7.4) — otherwise a rotating
/// User-Agent alone mints unlimited vote identities from one IP.
model ArticleCommentVote {
  id              String   @id @default(uuid())
  commentId       String
  userId          String?
  fingerprintHash String?
  helpful         Boolean
  createdAt       DateTime @default(now())

  comment ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([commentId, userId], name: "uq_acv_user")
  @@unique([commentId, fingerprintHash], name: "uq_acv_fp")
  @@index([commentId])
}

/// Abuse report. Gains the two uniques CompanyReviewReport never had, so one
/// guest cannot trip AUTO_FLAG_THRESHOLD alone, and a resolve path that is
/// actually read.
model ArticleCommentReport {
  id             String    @id @default(uuid())
  commentId      String
  reporterUserId String?
  reporterFp     String?
  reason         String
  detail         String?
  resolved       Boolean   @default(false)
  resolution     String? // deliberately NOT named `note` — `note` is in SENSITIVE_KEYS
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  comment ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterFp], name: "uq_acr_fp")
  @@unique([commentId, reporterUserId], name: "uq_acr_user")
  @@index([resolved, createdAt])
}

/// Closes the "Was this helpful?" half-implementation — v1 of the plan had the
/// two counter columns with no endpoint, no dedupe and no admin surface.
model ArticleHelpfulVote {
  id              String   @id @default(uuid())
  articleId       String
  userId          String?
  fingerprintHash String
  helpful         Boolean
  comment         String? // "what was missing?" free text, feeds the content-audit report
  createdAt       DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([articleId, fingerprintHash], name: "uq_ahv_fp")
  @@index([articleId, helpful])
}

/// Content → business-outcome attribution. This is a JOB PORTAL: the metric
/// that matters is which article produced an application, not how long someone
/// read. GA4 cannot answer it (unreadable server-side), so this is first-party.
///
/// Modelled on the SHIPPED WaConversion (schema.prisma:4211); written by
/// article-conversion.service.ts, cloned from whatsapp-conversion.service.ts's
/// recordConversion(), which also bumps a denormalised counter —
/// Article.conversionCount mirrors that so list views need no join.
///
/// Last touch comes from a first-party `ha_content_ref` cookie (30d), read at
/// the existing application-create / register / order-paid call sites. That
/// cookie must NEVER enter the CDN cache key — article HTML is edge-cached and
/// a Vary on it would shatter the cache all 16 carousel placements rely on.
enum ArticleConversionType {
  CTA_CLICK
  JOB_VIEW
  APPLICATION_SUBMITTED
  REGISTRATION
  PLAN_PURCHASE
}

model ArticleConversion {
  id              String                @id @default(uuid())
  articleId       String
  userId          String?
  fingerprintHash String?
  type            ArticleConversionType
  jobId           String?
  orderId         String?
  valuePaise      Int?
  occurredAt      DateTime              @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, occurredAt])
  @@index([type, occurredAt])
}

/// Co-author and reviewer bylines — the E-A-T signals the plan names stop at a
/// single Person without this.
///
/// `Article.authorId` STAYS as the denormalised primary byline, so every
/// existing index (@@index([authorId, status, publishedAt])) and the author-hub
/// query are unchanged. This table is additive.
enum ArticleBylineRole {
  AUTHOR
  CO_AUTHOR
  REVIEWER
}

model ArticleAuthorOnArticle {
  articleId    String
  authorId     String
  role         ArticleBylineRole
  displayOrder Int               @default(0)

  article Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  ArticleAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([articleId, authorId, role])
  @@index([authorId])
}

/// Unauthenticated draft-share links. The plan called these "revocable" with no
/// store behind the word — revocation needs a row to revoke.
///
/// The public resolver MUST return the D17 working copy, not the live row:
/// "share a preview of my changes" is the entire use case.
model ArticleShareToken {
  id          String    @id @default(uuid())
  articleId   String
  token       String    @unique
  createdById String?
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, revokedAt])
  @@index([expiresAt])
}

/// Real 404 traffic, so the "404 monitor" sees what users and external sites
/// actually hit — not only the broken links the crawler already knew about.
model ArticleNotFoundHit {
  id                 String   @id @default(uuid())
  path               String   @unique
  referrerHost       String?
  count              Int      @default(0)
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @updatedAt
  resolvedRedirectId String? // set when an admin creates the redirect from this row

  @@index([count])
  @@index([lastSeenAt])
}

/// Public corrections notice. A system that publishes NEWS needs one: silently
/// editing a published story is the failure mode this prevents. Written from
/// the same path that already detects a material body change on a PUBLISHED
/// article (the revision cut described in the retention policy).
model ArticleCorrection {
  id                String   @id @default(uuid())
  articleId         String
  body              String   @db.Text
  correctedByUserId String?
  isPublic          Boolean  @default(true)
  createdAt         DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

/// D12's LEAD_GATED, made real. Modelled on the shipped VendorLead
/// (schema.prisma:1449). The capture endpoint carries the SAME guard stack as
/// guest comments — own createRedisStore prefix, Turnstile failing closed,
/// publicAudit() (plain audit() only fires when req.user exists), and a
/// ConsentService record. `email` is never returned in a public payload.
model ArticleLead {
  id              String   @id @default(uuid())
  articleId       String
  email           String
  name            String?
  phone           String?
  consentId       String?
  source          String // which CTA block captured it
  fingerprintHash String?
  createdAt       DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, email])
  @@index([createdAt])
}

/// Save-for-later. Ships in v1 because both surfaces it needs (the candidate and
/// employer dashboards) are already being edited for the §9a carousel.
/// Series and author-follow are deferred to 13.11/13.12 with stated reasons.
model ArticleBookmark {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
}

/// D16 — per-article FAQ pairs. RELATIONAL, not a Json blob on Article, and not
/// prose inside the body: authored in a repeatable-row super-admin panel so the
/// data is schema-valid by construction, and rendered into the page at a fixed
/// position. Feeds faqPageSchema() (json-ld.ts:418), which already exists.
///
/// `answerHtml` goes through the SAME sanitizeArticleHtml() as the body — it is
/// a rich field (links + basic marks), so it is an XSS surface if it does not.
///
/// One FAQPage entity per PAGE: if PageFaqSection also renders on this article,
/// the article's own blocks win and PageFaqSection suppresses its emission.
model ArticleFaq {
  id         String  @id @default(uuid())
  articleId  String
  // D17 — the working copy applies here too. A live set (isDraft=false) and an
  // edited set (isDraft=true) coexist while an article is published; promote
  // deletes the live rows and flips the draft rows. Without this, FAQ edits
  // would bypass the buffer and go live instantly.
  isDraft    Boolean @default(false)
  position   Int
  question   String
  answerHtml String  @db.Text
  // FK, not a URL string: refCount is recomputed from REFERENCES (plan §8.1),
  // and an image reachable only through a Json blob would be invisible to that
  // recompute — the nightly GC would then delete a live image.
  imageAssetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  image   ArticleAsset? @relation("ArticleFaqImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@unique([articleId, isDraft, position], name: "uq_afaq_position")
  @@index([articleId, isDraft, position])
}

/// D16 — How-To steps. Mirrors howToSchema() (json-ld.ts:434), which ships
/// today with a complete shape and ZERO consumers.
///
/// NOTE: Google retired How-To rich results in 2023. This exists for authoring
/// quality, on-page rendering and AI/answer-engine surfaces — not for a SERP
/// carousel. Do not sell it as one.
///
/// Emission gate: Article.howToEnabled AND at least 2 steps.
model ArticleHowToStep {
  id           String  @id @default(uuid())
  articleId    String
  isDraft      Boolean @default(false) // D17 working copy
  position     Int
  name         String
  text         String  @db.Text
  imageAssetId String?
  url          String? // optional deep link for this step

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  image   ArticleAsset? @relation("ArticleHowToStepImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@unique([articleId, isDraft, position], name: "uq_ahts_position")
  @@index([articleId, isDraft, position])
}

/// Per-article per-UTC-day rollup. uniqueViews comes from a Redis HyperLogLog
/// (PFADD per request, PFCOUNT at flush) — plain INCR cannot dedupe.
model ArticleViewDaily {
  id          String   @id @default(uuid())
  articleId   String
  day         DateTime // UTC midnight; the analytics UI labels the timezone
  views       Int      @default(0)
  uniqueViews Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, day])
  @@index([day])
}

/// Media library + reference counting, so orphan GC is possible.
///
/// CLOUDINARY, not R2 (plan D13). R2 is documents + backups; every image in the
/// app already goes through config/cloudinary.ts, and jobs/image-processing.worker.ts
/// generates responsive variants into Cloudinary folders. Folder convention:
/// `articles/{kind}/{articleId}`. Deletion is deleteImage(extractPublicId(url)).
model ArticleAsset {
  id           String   @id @default(uuid())
  articleId    String?
  publicId     String   @unique // Cloudinary public_id
  secureUrl    String // https delivery URL
  variants     Json? // responsive set produced by image-processing.worker
  mimeType     String
  bytes        Int
  width        Int // required — dimensionless images are rejected at upload (CLS)
  height       Int
  alt          String? // required for BODY images at upload; publish checklist lints it
  refCount     Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  // D16 back-relations. These are why FAQ/How-To images are FKs rather than
  // URLs in a Json blob: refCount recompute (plan §8.1) can see them.
  faqImages       ArticleFaq[]       @relation("ArticleFaqImage")
  howToStepImages ArticleHowToStep[] @relation("ArticleHowToStepImage")

  @@index([articleId])
  @@index([refCount])
}

/// Content graph — rebuilt in the SAME post-sanitise pass as every body save
/// (D10 revised), never only on publish: the pre-publish "internal links
/// present" lint and the orphan report both read it before anything is
/// published, and would have no data otherwise. Powers the
/// incoming-links panel, orphan detection and the broken-link cron.
model ArticleLink {
  id            String   @id @default(uuid())
  fromArticleId String
  toArticleId   String?
  href          String
  anchorText    String?
  rel           String?
  isExternal    Boolean  @default(false)
  lastCheckedAt DateTime?
  lastStatus    Int?
  createdAt     DateTime @default(now())

  fromArticle Article  @relation("ArticleOutLinks", fields: [fromArticleId], references: [id], onDelete: Cascade)
  toArticle   Article? @relation("ArticleInLinks", fields: [toArticleId], references: [id], onDelete: SetNull)

  @@index([fromArticleId])
  @@index([toArticleId])
  @@index([isExternal, lastStatus])
}

/// Editorial assignment.
model ArticleAssignment {
  id           String                @id @default(uuid())
  articleId    String
  userId       String
  role         ArticleAssignmentRole
  assignedById String?
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime              @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId, role])
  @@index([userId, completedAt])
  @@index([dueAt])
}

/// Every status transition, for the workflow audit trail.
model ArticleWorkflowEvent {
  id         String         @id @default(uuid())
  articleId  String
  fromStatus ArticleStatus?
  toStatus   ArticleStatus
  actorId    String?
  reason     String?
  createdAt  DateTime       @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

/// Soft edit lock — 60s heartbeat, takeover-with-warning, released on navigate.
model ArticleLock {
  id          String   @id @default(uuid())
  articleId   String   @unique
  userId      String
  acquiredAt  DateTime @default(now())
  heartbeatAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([heartbeatAt])
}

/// Comments-on-drafts (internal), modelled on EmailThreadNote.
model ArticleNote {
  id         String    @id @default(uuid())
  articleId  String
  blockId    String? // ProseMirror node id, when anchored to a block
  authorId   String
  body       String    @db.Text
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

/// Commenter-level moderation — ban a fingerprint, an email or an account.
model BlockedCommenter {
  id              String    @id @default(uuid())
  fingerprintHash String?
  email           String?
  userId          String?
  reason          String
  shadowBan       Boolean   @default(false)
  blockedById     String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@unique([fingerprintHash])
  @@unique([email])
  @@unique([userId])
  @@index([expiresAt])
}

