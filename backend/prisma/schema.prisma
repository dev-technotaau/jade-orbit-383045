// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
  SUPER_ADMIN
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String?
  role      Role    @default(CANDIDATE)
  firstName String?
  lastName  String?
  avatar    String?

  // Client-managed UI preferences (sidebar pins / section expansion /
  // collapsed rail, etc.) — an opaque JSON blob whose shape is owned by the
  // frontend.
  uiPreferences Json?

  // Social Auth
  googleId   String? @unique
  linkedinId String? @unique

  // Mobile Auth
  mobileNumber              String?   @unique
  isMobileVerified          Boolean   @default(false)
  mobileVerificationToken   String?
  mobileVerificationExpires DateTime?

  // WhatsApp
  isWhatsappVerified          Boolean   @default(false)
  whatsappNumber              String? // Separate WhatsApp number (null = use mobileNumber)
  whatsappVerificationToken   String?
  whatsappVerificationExpires DateTime?

  // OTP resend tracking
  emailOtpResendCount    Int       @default(0)
  emailOtpLastSentAt     DateTime?
  mobileOtpResendCount   Int       @default(0)
  mobileOtpLastSentAt    DateTime?
  whatsappOtpResendCount Int       @default(0)
  whatsappOtpLastSentAt  DateTime?

  // Pending change fields (2-step email/mobile change)
  pendingEmail        String?
  pendingMobileNumber String?

  // Account Status
  isActive    Boolean   @default(true)
  isSuspended Boolean   @default(false)
  suspendedAt DateTime?
  suspendedBy String?

  // Email Verification
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  // Password Reset
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // MFA (TOTP)
  mfaSecret      String?
  mfaEnabled     Boolean  @default(false)
  mfaBackupCodes String[] @default([])

  // MFA Recovery
  mfaRecoveryToken   String?
  mfaRecoveryExpires DateTime?

  // Account Security
  loginAttempts Int       @default(0)
  lockUntil     DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?

  // Activity Tracking
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  sessions      Session[]

  // Profiles
  candidateProfile CandidateProfile?
  companyProfile   CompanyProfile?
  savedJobs        SavedJob[]

  // Verifications
  verificationRequests  VerificationRequest[] @relation("UserVerifications")
  reviewedVerifications VerificationRequest[] @relation("AdminReviews")

  // Notifications, Drafts, Devices
  notifications     Notification[]
  formDrafts        FormDraft[]
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]
  smsMessages       SmsMessage[]

  // Saved Candidates & Searches
  savedCandidates      SavedCandidate[]      @relation("EmployerSavedCandidates")
  savedByEmployers     SavedCandidate[]      @relation("CandidateSavedBy")
  savedSearches        SavedSearch[]
  searchHistory        SearchHistory[]
  followedCompanies    CompanyFollow[]
  candidateLists       CandidateList[]       @relation("EmployerCandidateLists")
  candidateListMembers CandidateListMember[] @relation("CandidateInLists")
  addedListMembers     CandidateListMember[] @relation("ListMembersAddedBy")
  jobMatches           JobCandidateMatch[]   @relation("CandidateMatches")

  // Employer multi-seat team
  employerTeamSeats   EmployerTeamMember[] @relation("EmployerTeamUser")
  employerTeamInvites EmployerTeamMember[] @relation("EmployerTeamInvitedBy")

  // Vendor Connect
  vendorProfile         VendorProfile?   @relation("VendorOwner")
  vendorLeadsAsEmployer VendorLead[]     @relation("VendorLeadEmployer")
  vendorReviewsLeft     VendorReview[]   @relation("VendorReviewer")
  savedVendorJobs       SavedVendorJob[] @relation("VendorJobSaver")

  // Assisted Hiring
  assistedHiringRequests           AssistedHiringRequest[]        @relation("AssistedHiringEmployer")
  assistedHiringAssigned           AssistedHiringRequest[]        @relation("AssistedHiringAssignee")
  assistedHiringMatchedAsCandidate AssistedHiringMatchedProfile[] @relation("AssistedHiringCandidate")

  // WebAuthn & Webhooks
  webauthnCredentials WebAuthnCredential[]
  webhookEndpoints    WebhookEndpoint[]

  // Support Tickets
  tickets         SupportTicket[] @relation("UserTickets")
  assignedTickets SupportTicket[] @relation("AssignedTickets")

  // Profile Views
  profileViews    ProfileView[] @relation("ProfileViewer")
  profileViewedBy ProfileView[] @relation("ProfileViewed")

  // Company Reviews (auth-user authored + helpful-vote dedup)
  companyReviews     CompanyReview[]
  companyReviewVotes CompanyReviewVote[]

  // Job Alerts & Recommendations
  jobAlerts                JobAlert[]
  dismissedRecommendations DismissedRecommendation[]

  // Security & Privacy
  deletionRequestedAt DateTime?
  knownDevices        KnownDevice[]
  loginLocations      LoginLocation[]
  consents            UserConsent[]
  mfaTrustedDevices   MfaTrustedDevice[]

  // Billing / Payments / Subscriptions
  orders               Order[]
  payments             Payment[]
  subscriptions        Subscription[]
  entitlements         Entitlement[]
  invoices             Invoice[]
  couponRedemptions    CouponRedemption[]
  mandates             Mandate[]
  paymentMethods       PaymentMethodToken[]
  quoteRequests        QuoteRequest[]
  billingAddresses     BillingAddress[]
  billingLedger        BillingLedger[]
  resourceLedger       ResourceLedger[]
  fraudFlags           FraudSignalEvent[]
  upgradeChanges       UpgradeChange[]
  billingNotifications BillingNotification[]
  refundsInitiated     Refund[]               @relation("RefundsInitiatedBy")
  refundRequests       RefundRequest[]        @relation("RefundRequestsByUser")
  refundRequestReviews RefundRequest[]        @relation("RefundRequestsReviewedBy")
  customPlanOffers     CustomPlanOffer[]      @relation("CustomPlanOffersCreatedBy")
  plansCreated         Plan[]                 @relation("PlansCreatedBy")
  couponsCreated       Coupon[]               @relation("CouponsCreatedBy")
  fraudReviews         FraudSignalEvent[]     @relation("FraudReviewedBy")
  fraudRulesUpdated    FraudRule[]            @relation("FraudRulesUpdatedBy")
  webhookReplays       RazorpayWebhookEvent[] @relation("WebhookReplayedBy")
  assignedQuotes       QuoteRequest[]         @relation("QuoteAssignedTo")
  priceAdjustments     PriceAdjustment[]      @relation("PriceAdjustmentsCreatedBy")
  planVersions         PlanVersion[]          @relation("PlanVersionsPublishedBy")

  // WhatsApp system (super-admin operated)
  waContact               WaContact?
  waAssignedConversations WaConversation[] @relation("WaAssignee")
  waCampaigns             WaCampaign[]     @relation("WaCampaignCreator")

  // Email system (super-admin operated)
  emailContact         EmailContact?
  emailAssignedThreads EmailThread[]   @relation("EmailAssignee")
  emailCampaigns       EmailCampaign[] @relation("EmailCampaignCreator")
  emailAccounts        EmailAccount[]  @relation("EmailAccountOwner")

  // Admin PBAC (only populated for Role.ADMIN — SUPER_ADMIN is authorised by
  // role and deliberately holds no grant rows)
  adminPermissionGrants AdminPermissionGrant[] @relation("AdminPermissionGrants")
  permissionGrantsMade  AdminPermissionGrant[] @relation("AdminPermissionGrantedBy")
  adminRoleAssignments  AdminRoleAssignment[]  @relation("AdminRoleAssignments")
  adminActivityLogs     AdminActivityLog[]     @relation("AdminActivityLogs")
  resourceLocks         ResourceLock[]         @relation("ResourceLocks")

  @@index([email])
  @@index([role])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  // Device info
  userAgent String?
  ipAddress String?

  // Link to session
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([sessionId])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  userAgent  String?
  ipAddress  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  lastSeenAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([isActive])
  @@index([userId, isActive])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String // e.g., "CREATE_JOB", "DELETE_USER"
  entity      String // e.g., "Job", "User"
  entityId    String? // ID of the affected entity
  performedBy String? // User ID of who performed the action
  details     Json? // Additional context (e.g., diff of changes)
  ipAddress   String?
  userAgent   String?
  checksum    String? // SHA-256 integrity checksum
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  user User? @relation(fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([performedBy])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

