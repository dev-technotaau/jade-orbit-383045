// --- Models ---

model CandidateProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Personal Details
  headline           String? // Professional headline ("Senior Java Dev | 8 yrs exp")
  pronouns           String? // e.g., "he/him", "she/her", "they/them"
  gender             Gender?
  dob                DateTime?
  maritalStatus      MaritalStatus?
  nationality        String?              @default("Indian")
  hometown           String?
  category           ReservationCategory? // Indian reservation: GENERAL, SC, ST, OBC, EWS
  bio                String?
  resume             String? // URL to file (Cloudinary/R2)
  resumeOriginalName String?
  resumeSize         Int? // File size in bytes
  resumeMimeType     String? // MIME type (application/pdf, etc.)
  resumeUploadedAt   DateTime? // Exact timestamp of resume upload
  additionalResumes  Json? // Array of { name, url, originalName?, isDefault?, uploadedAt? }
  generatedResumeUrl String? // URL to last generated resume (R2)
  generatedResumeAt  DateTime? // When the resume was last generated
  videoResumeUrl     String? // URL to video resume
  profileImage       String? // Cloudinary URL
  imageVariants      Json? // { thumbnail, small, medium, original } URLs

  // Structured Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  country      String? @default("India")

  // Contact & Location
  currentLocation    String?
  preferredLocations String[]
  phone              String?
  alternatePhone     String?
  alternateEmail     String?

  // Geo Coordinates (auto-populated by geocoding worker)
  latitude  Float?
  longitude Float?

  // Professional
  experienceYears       Float             @default(0)
  totalExperienceMonths Int? // More precise than Float years
  experienceLevel       ExperienceLevel? // FRESHER through EXECUTIVE (matches JobPost.experienceLevel)
  currentCompany        String?
  currentRole           String?
  currentIndustry       String?
  currentDepartment     String?
  functionalArea        String?
  currSalary            Decimal?          @db.Decimal(12, 2)
  expectedSalaryMin     Decimal?          @db.Decimal(12, 2)
  expectedSalaryMax     Decimal?          @db.Decimal(12, 2)
  salaryCurrency        String            @default("INR")
  noticePeriod          NoticePeriod?
  servingNoticePeriod   Boolean           @default(false)
  workStatus            WorkStatus?       @default(ACTIVELY_LOOKING)
  hasCareerBreak        Boolean           @default(false)
  careerBreakType       CareerBreakType?
  careerBreakReason     String?
  openToWork            OpenToWorkStatus?

  // Career Preferences
  preferredJobType         JobType[]  @default([])
  preferredWorkMode        WorkMode[] @default([])
  preferredShift           ShiftType?
  preferredIndustries      String[]   @default([])
  preferredRoleCategories  String[]   @default([])
  dateOfAvailability       DateTime?
  willingToRelocate        Boolean?   @default(false)
  travelWillingnessPercent Int?       @default(0)

  // Education Summary (matches JobPost education filters)
  highestEducationLevel EducationLevel? // Matches JobPost.educationRequired
  highestDegree         SpecificDegree? // Matches JobPost.specificDegrees

  // Visa, Work Authorization & Documents
  visaStatus         String?
  workPermitStatus   String?
  passportNumber     String?
  passportExpiryDate DateTime?
  hasDrivingLicense  Boolean             @default(false)
  drivingLicenseType DrivingLicenseType? @default(NONE) // Matches JobPost.drivingLicenseRequired
  ownVehicle         Boolean             @default(false)
  vehicleTypes       VehicleType[]       @default([])
  isVeteran          Boolean             @default(false)
  blockedCompanies   String[]            @default([])

  // Skills & Education (JSON for flexibility)
  skills                  String[]
  languages               String[]
  itSkills                Json? // Array of { technology, version?, lastUsed?, experienceYears?, proficiency? }
  education               Json? // Array of { institution, degree, field, startDate, endDate?, grade?, gradeType?, courseType?, specialization?, description?, activities? }
  experience              Json? // Array of { company, role, location?, industry?, department?, employmentType?, startDate, endDate?, isCurrent?, description?, keyAchievements[]?, teamSize?, reportingTo?, annualCtc? }
  certifications          Json? // Array of { name, issuer, issueDate?, expiryDate?, credentialId?, url?, doesNotExpire? }
  projects                Json? // Array of { name, description?, url?, startDate?, endDate?, technologies[]?, role?, teamSize?, client?, isCurrent? }
  publications            Json? // Array of { title, publisher?, publicationDate?, url?, description?, authors? }
  patents                 Json? // Array of { title, patentOffice?, patentNumber?, status?, filingDate?, issueDate?, url?, description?, inventors? }
  awards                  Json? // Array of { title, issuer?, date?, description? }
  volunteerExperience     Json? // Array of { organization, role, cause?, startDate?, endDate?, isCurrent?, description? }
  professionalMemberships Json? // Array of { organization, role?, startDate?, endDate?, membershipId?, description? }
  courses                 Json? // Array of { name, provider?, completionDate?, url?, associatedWith? }
  testScores              Json? // Array of { testName, score, dateOfExam?, associatedWith?, description? }
  references              Json? // Array of { name, designation?, organization?, email?, phone?, relationship? }
  languageProficiency     Json? // Array of { language, proficiency: BASIC|INTERMEDIATE|FLUENT|NATIVE, readWrite? }
  skillsWithProficiency   Json? // Array of { skill, proficiency: BEGINNER|INTERMEDIATE|ADVANCED|EXPERT, yearsOfExperience? }

  // Interests
  interests String[] @default([])
  hobbies   String[] @default([])

  // Disability Details
  isPhysicallyChallenged Boolean         @default(false)
  disabilityType         DisabilityType? @default(NONE)
  disabilityPercentage   Int?

  // Social & Online Profiles
  githubProfile        String?
  linkedinProfile      String?
  portfolioUrl         String?
  stackOverflowProfile String?
  twitterProfile       String?
  personalBlogUrl      String?
  dribbbleProfile      String?
  behanceProfile       String?
  mediumProfile        String?
  youtubeChannel       String?

  // AI-parsed resume data (from Document AI)
  parsedResumeData Json?

  // Notification Preferences
  notificationPreferences Json? // { emailNotifications, smsNotifications, whatsappNotifications, inAppNotifications, fcmNotifications, webPushNotifications }

  // Cached scores
  profileCompleteness Int @default(0) // 0-100 percentage

  // Discretionary profile-boost activation (Candidate Premium plan).
  // The plan grants a 7-day BOOST_DAYS pool the candidate spends ONE
  // day at a time via POST /candidates/me/boost/activate. Each
  // activation consumes 1 BOOST_DAYS resource and sets this column
  // to now+24h (or extends it if already in the future). Search
  // ranking checks BOTH the boost feature flag AND this timestamp
  // before applying the rank weight.
  profileBoostActiveUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([userId])
  @@index([currentLocation])
  @@index([experienceYears])
  @@index([workStatus])
  @@index([noticePeriod])
  @@index([currentIndustry])
  @@index([willingToRelocate])
  @@index([openToWork])
  @@index([city, state])
  @@index([latitude, longitude])
  @@index([workStatus, noticePeriod, experienceYears])
  @@index([experienceLevel])
  @@index([highestEducationLevel])
  @@index([functionalArea])
  @@index([profileCompleteness])
  @@index([highestDegree])
  @@index([drivingLicenseType])
  @@index([profileBoostActiveUntil])
}

model CompanyProfile {
  id     String @id @default(uuid())
  userId String @unique

  // SEO + public-search slug. Generated from companyName via
  // buildCompanySlug() with collision suffixing (-2, -3, ...). Used in
  // the canonical /companies/{slug} URL.
  slug             String? @unique
  // Employer can opt out of the public CV-database / company-directory
  // surfaces per row. Defaults to true so existing public-by-default
  // semantics are preserved.
  publicSearchable Boolean @default(true)

  // Account Classification
  accountType AccountType? // COMPANY or INDIVIDUAL
  hiringType  HiringType? // DIRECT (own company) or CONSULTANCY (staffing agency)

  // Company Details
  companyName     String
  companyType     CompanyType? // PRIVATE, PUBLIC, STARTUP, MNC, GOVERNMENT, etc.
  tagline         String?
  logo            String? // Cloudinary URL
  logoVariants    Json? // { thumbnail, small, medium, original } URLs
  coverImage      String? // Banner image (Cloudinary URL)
  coverVariants   Json? // { thumbnail, small, medium, original } URLs
  companyVideoUrl String? // Company intro/culture video URL
  industry        String?
  subIndustry     String? // e.g., "SaaS", "Payments", "Cloud Infrastructure"
  specialties     String[]     @default([])
  companySize     String? // e.g., "1-10", "11-50"
  employeeCount   Int? // Approximate exact count
  numberOfOffices Int? // Total number of office locations
  description     String?
  whyWorkForUs    String? // Employer pitch / "Why Work For Us" section
  website         String?
  careersPageUrl  String? // Company careers page
  blogUrl         String? // Company blog
  foundedYear     Int?
  parentCompany   String? // Parent/holding company
  stockTicker     String? // Stock exchange ticker symbol

  // Registration & Verification
  gstNumber   String? @unique
  cinNumber   String? @unique // Corporate Identity Number (India)
  panNumber   String?
  llpinNumber String? // LLP Identification Number (MCA, format AAA-9999)
  tanNumber   String? // Tax Deduction Account Number (format AAAA99999A)
  isVerified  Boolean @default(false)

  // Financial & Funding
  annualRevenueRange       String? // e.g., "1-5 Cr", "100-500 Cr"
  fundingStage             FundingStage?
  totalFundingRaised       String? // Display string, e.g. "$50M", "₹200 Cr" — kept for legacy rows + read sites
  // Structured funding (new entry path writes both: these for queries,
  // totalFundingRaised as the formatted display string)
  totalFundingRaisedAmount Decimal?      @db.Decimal(18, 2)
  fundingCurrency          String?       @default("INR")
  investors                String[]      @default([])

  // Products & Tech
  productsServices String[] @default([])
  techStack        String[] @default([])

  // Culture & Benefits
  companyCulture         String?
  missionStatement       String?
  visionStatement        String?
  coreValues             String[] @default([])
  diversityStatement     String?
  employeeResourceGroups String[] @default([])
  csrInitiatives         String? // CSR / social impact description
  benefits               String[] @default([])
  structuredPerks        Json? // Array of { category, perks[] }
  workplacePolicies      Json? // Array of { title, description }
  interviewProcess       String? // Description of interview/hiring process
  awardsRecognitions     Json? // Array of { title, year?, issuingOrg?, description? }
  leadershipTeam         Json? // Array of { name, designation, linkedinUrl?, imageUrl?, bio? }
  employeeTestimonials   Json? // Array of { name, designation?, department?, quote, imageUrl? }
  officePhotos           Json? // Array of { url, caption?, location? }
  socialLinks            Json? // { linkedin, twitter, facebook, instagram, youtube, glassdoor }

  // Contact
  contactEmail             String?
  contactPhone             String?
  contactPersonName        String?
  contactPersonDesignation String?

  // Notification Preferences
  notificationPreferences Json? // { emailApplications, emailMessages, emailMarketing, smsAlerts, whatsappNotifications, inAppNotifications, fcmNotifications, webPushNotifications, weeklyDigest }

  // Structured Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  country      String? @default("India")

  // Location
  headquarters String?
  locations    String[]

  // Geo Coordinates (auto-populated by geocoding worker)
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Default billing address — pointer into BillingAddress (per plan §2.3).
  // Used by checkout to pre-fill the buyer's GST/legal name + place-of-supply.
  // Optional: many companies start without a billing address until first paid order.
  defaultBillingAddressId String?

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                  JobPost[]
  jobTemplates          JobTemplate[]
  defaultBillingAddress BillingAddress?         @relation("CompanyDefaultBillingAddress", fields: [defaultBillingAddressId], references: [id], onDelete: SetNull)
  teamMembers           EmployerTeamMember[]    @relation("CompanyTeamMembers")
  followers             CompanyFollow[]
  reviews               CompanyReview[]
  reviewAggregate       CompanyReviewAggregate?

  @@index([userId])
  @@index([companyName])
  @@index([companyType])
  @@index([industry])
  @@index([fundingStage])
  @@index([city, state])
  @@index([latitude, longitude])
  @@index([defaultBillingAddressId])
  @@index([slug])
  @@index([publicSearchable, isVerified])
}

model JobPost {
  id        String @id @default(uuid())
  companyId String

  // SEO + public-search slug. Generated from
  // {title-kebab}-{company-or-city-kebab}-{shortid8} via buildJobSlug().
  // Used in the canonical /jobs/{slug} URL.
  slug             String? @unique
  // Employer can opt out of the public job-board surface per job
  // (e.g. confidential search). When false, the job is still visible
  // to invited candidates but excluded from /jobs and search engines.
  publicSearchable Boolean @default(true)

  // Consultancy / Staffing — the actual client company this job is for
  clientCompanyName String?

  // Job Details
  title               String
  description         String
  keyResponsibilities String? // Separate from description (Naukri-style)
  requirements        String? // Rich text or raw text
  benefits            String?

  // Metadata
  type      JobType    @default(FULL_TIME)
  status    JobStatus  @default(OPEN)
  workMode  WorkMode?  @default(ON_SITE) // ON_SITE, REMOTE, HYBRID
  shiftType ShiftType? // DAY, NIGHT, ROTATIONAL, FLEXIBLE

  // Classification
  industry       String?
  department     String?
  roleCategory   String?
  functionalArea FunctionalArea?

  // Experience & Education
  experienceMin           Int              @default(0)
  experienceMax           Int?
  experienceLevel         ExperienceLevel? // FRESHER through EXECUTIVE
  educationRequired       EducationLevel? // Minimum education level
  preferredEducationField String?
  ugRequired              EducationLevel?
  pgRequired              EducationLevel?
  specificDegrees         SpecificDegree[] @default([])
  degreeSpecializations   String[]         @default([])

  // Compensation & Location
  location         String
  latitude         Float?
  longitude        Float?
  isRemote         Boolean     @default(false) // Kept for backward compat
  salaryMin        Decimal?    @db.Decimal(12, 2)
  salaryMax        Decimal?    @db.Decimal(12, 2)
  currency         String      @default("INR")
  salaryType       SalaryType? @default(ANNUAL) // ANNUAL, MONTHLY, HOURLY
  salaryDisclosed  Boolean     @default(true)
  salaryNegotiable Boolean     @default(false)

  // Skills
  skillsRequired         String[]
  niceToHaveSkills       String[]                 @default([])
  certificationsRequired String[]                 @default([])
  languagesRequired      Json? // Array of { language, proficiency }
  noticePeriodPreference NoticePeriodPreference[] @default([])

  // Vacancy & Urgency
  numberOfOpenings  Int?          @default(1)
  /**
   * Hires made OFF the platform for this posting (walk-ins, referrals, agency
   * placements). Vacancy fill = HIRED applications + this. Without it a job
   * filled offline could never reflect reality: there is no application row to
   * mark HIRED, so the listing would stay open forever advertising seats that
   * are gone. Employer-maintained; never auto-derived.
   */
  offlineHiresCount Int           @default(0)
  urgencyLevel      UrgencyLevel? @default(NORMAL)
  isFeatured        Boolean       @default(false)
  isPremium         Boolean       @default(false)
  isConfidential    Boolean       @default(false)
  referenceCode     String?

  // Content & SEO
  tags     String[] @default([])
  jobPerks String[] @default([])

  // Travel & Relocation
  // Was `travelRequirementPercent Int?` — employers could not meaningfully
  // estimate a percentage, so it is now a plain yes/no. The migration carries
  // the old data across as `percent > 0`.
  travelRequired        Boolean  @default(false)
  relocationAssistance  Boolean  @default(false)
  additionalLocations   String[] @default([])
  accommodationProvided Boolean  @default(false)

  // Application & Interview
  applicationDeadline DateTime?
  interviewProcess    String?
  isWalkIn            Boolean   @default(false)
  walkInDetails       Json? // { date, time, venue, contactPerson, contactPhone }
  contactPerson       String?
  contactEmail        String?
  // Recruiter mobile for this posting. Like contactPerson/contactEmail this is
  // INTERNAL — `sanitiseJobForPublic` already strips `contactPhone`, so it
  // never reaches a public payload.
  contactPhone        String?

  // Walk-in structured fields
  walkInStartDate     DateTime?
  walkInEndDate       DateTime?
  walkInTime          String?
  walkInVenue         String?
  walkInContactPerson String?
  walkInContactPhone  String?
  walkInInstructions  String?

  // Diversity & Inclusion
  diversityTags String[] @default([])

  // Compliance & Requirements
  visaSponsorshipAvailable Boolean             @default(false)
  backgroundCheckRequired  Boolean             @default(false)
  isPwdFriendly            Boolean             @default(false)
  passportRequired         Boolean             @default(false)
  bondDetails              String?
  drivingLicenseRequired   DrivingLicenseType?

  // Age & Gender (India-specific)
  ageMin           Int?
  ageMax           Int?
  genderPreference GenderPreference? @default(ANY)

  // Posting Control
  postingVisibility  PostingVisibility @default(PUBLIC)
  applyMethod        ApplyMethod       @default(IN_PLATFORM)
  externalApplyUrl   String?
  scheduledPublishAt DateTime?

  // Relations for screening
  screeningQuestions ScreeningQuestion[]

  // Stats
  views Int @default(0)

  // Lifecycle
  closedReason          String? // "EXPIRED", "FILLED", "CANCELLED"
  closedAt              DateTime?
  expiresAt             DateTime?
  lastExpirationWarning DateTime? // Last time an expiration warning was sent
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company                CompanyProfile            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications           JobApplication[]
  savedBy                SavedJob[]
  dismissedBy            DismissedRecommendation[]
  candidateMatches       JobCandidateMatch[]
  vendorLeads            VendorLead[]
  savedByVendors         SavedVendorJob[]
  assistedHiringRequests AssistedHiringRequest[]   @relation("AssistedHiringJob")

  @@index([companyId])
  @@index([status])
  @@index([title])
  @@index([location])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([industry])
  @@index([expiresAt])
  @@index([workMode])
  @@index([shiftType])
  @@index([experienceLevel])
  @@index([educationRequired])
  @@index([urgencyLevel])
  @@index([isFeatured])
  @@index([applicationDeadline])
  @@index([status, workMode])
  @@index([status, experienceLevel])
  @@index([status, expiresAt])
  @@index([latitude, longitude])
  @@index([functionalArea])
  @@index([postingVisibility])
  @@index([scheduledPublishAt])
  @@index([isConfidential])
  @@index([referenceCode])
  @@index([type])
  @@index([status, type])
  @@index([slug])
  @@index([publicSearchable, status])
}

model JobApplication {
  id          String @id @default(uuid())
  jobId       String
  candidateId String

  status         ApplicationStatus @default(APPLIED)
  coverLetter    String?
  resumeSnapshot String? // Link to resume at time of application

  // Match & Source
  matchScore     Float? // Pre-computed match score at apply time
  source         String? // "SEARCH", "RECOMMENDATION", "DIRECT", "WALK_IN", "REFERRAL"
  candidateNotes String? // Candidate's own notes about the application

  // Interview & Decision
  interviewDate     DateTime?
  interviewNotes    String?
  interviewFeedback Json? // Array of { stage, interviewer?, rating?, feedback?, date? }
  rejectionReason   String?
  viewedAt          DateTime? // When employer first viewed
  selectedAt        DateTime? // When employer selected candidate

  // Offer & Hiring
  offerDetails Json? // { salary, joiningDate, designation, location }
  offeredAt    DateTime?
  hiredAt      DateTime?

  appliedAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  reviewReminderSentAt DateTime? // Prevents duplicate review reminders

  job              JobPost           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate        CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  screeningAnswers ScreeningAnswer[]

  @@unique([jobId, candidateId]) // Prevent duplicate applications
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@index([jobId, status])
  @@index([candidateId, status])
  @@index([source])
  @@index([offeredAt])
  @@index([hiredAt])
}

model ScreeningQuestion {
  id            String                @id @default(uuid())
  jobId         String
  question      String
  questionType  ScreeningQuestionType @default(TEXT)
  isRequired    Boolean               @default(false)
  isDealBreaker Boolean               @default(false)
  options       Json?
  idealAnswer   String?
  displayOrder  Int                   @default(0)
  createdAt     DateTime              @default(now())

  job     JobPost           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers ScreeningAnswer[]

  @@index([jobId])
  @@index([jobId, displayOrder])
}

model ScreeningAnswer {
  id            String   @id @default(uuid())
  applicationId String
  questionId    String
  answer        String
  createdAt     DateTime @default(now())

  application JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId])
  @@index([questionId])
}

model JobTemplate {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  description  String?
  templateData Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, name])
}

model VerificationRequest {
  id     String @id @default(uuid())
  userId String

  type   VerificationType
  status VerificationStatus @default(PENDING)

  // Data
  documentUrl String? // R2/Cloudinary URL
  data        Json? // Extra data (e.g., entered GST number)

  // Admin logic
  reviewedBy    String?
  adminComments String?
  reviewedAt    DateTime?

  // Escalation
  escalatedAt      DateTime?
  escalatedBy      String?
  escalationReason String?
  priority         String?   @default("NORMAL") // NORMAL, HIGH, URGENT

  // SLA & Approval Chain
  slaDeadline          DateTime?
  approvalChain        Json? // Array of { level, approverId, approvedAt?, comments? }
  currentApprovalLevel Int?      @default(1)
  autoEscalated        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User  @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("AdminReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([type, status])
  @@index([priority])
}

model SavedJob {
  id     String @id @default(uuid())
  userId String
  jobId  String

  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

// --- Saved Candidates (Employer bookmarks candidates) ---

model SavedCandidate {
  id          String   @id @default(uuid())
  employerId  String
  candidateId String
  notes       String?
  savedAt     DateTime @default(now())

  employer  User @relation("EmployerSavedCandidates", fields: [employerId], references: [id], onDelete: Cascade)
  candidate User @relation("CandidateSavedBy", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([employerId, candidateId])
  @@index([employerId])
  @@index([candidateId])
}

// --- Vendor job board bookmarks ---
// An employer with the VENDOR_CONNECT capability bookmarks ANOTHER
// employer's open posting to pitch later. Distinct from a contact reveal
// (which consumes a VENDOR_LEAD unit and is tracked in ResourceLedger);
// saving is free and grants no contact access.
model SavedVendorJob {
  id           String   @id @default(uuid())
  vendorUserId String
  jobPostId    String
  createdAt    DateTime @default(now())

  vendorUser User    @relation("VendorJobSaver", fields: [vendorUserId], references: [id], onDelete: Cascade)
  jobPost    JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([vendorUserId, jobPostId])
  @@index([vendorUserId])
  @@index([jobPostId])
}

// --- Employer team / multi-seat (CV Enterprise feature.multi_seat) ---

enum TeamRole {
  OWNER
  ADMIN
  RECRUITER
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

model EmployerTeamMember {
  id              String           @id @default(uuid())
  companyId       String
  userId          String? // null until invite is accepted
  invitedEmail    String
  role            TeamRole         @default(RECRUITER)
  status          TeamMemberStatus @default(PENDING)
  invitedById     String
  inviteToken     String?          @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime         @default(now())
  joinedAt        DateTime?
  revokedAt       DateTime?

  company   CompanyProfile @relation("CompanyTeamMembers", fields: [companyId], references: [id], onDelete: Cascade)
  user      User?          @relation("EmployerTeamUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy User           @relation("EmployerTeamInvitedBy", fields: [invitedById], references: [id])

  @@unique([companyId, invitedEmail])
  @@index([companyId])
  @@index([userId])
  @@index([inviteToken])
}

// --- Assisted Hiring fulfilment workflow (₹1499 plan) ---

enum AssistedHiringStatus {
  PENDING
  CALL_SCHEDULED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

model AssistedHiringRequest {
  id                String               @id @default(uuid())
  employerId        String
  orderId           String?              @unique
  jobPostId         String?
  roleTitle         String
  requirementText   String
  preferredSkills   String[]             @default([])
  preferredLocation String?
  budgetRange       String?
  noticePeriod      String?
  contactEmail      String
  contactPhone      String?
  status            AssistedHiringStatus @default(PENDING)
  internalNotes     String?
  callScheduledAt   DateTime?
  deliveredAt       DateTime?
  startedAt         DateTime             @default(now())
  expiresAt         DateTime?
  assignedAdminId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  employer        User                           @relation("AssistedHiringEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  order           Order?                         @relation("AssistedHiringOrder", fields: [orderId], references: [id], onDelete: SetNull)
  jobPost         JobPost?                       @relation("AssistedHiringJob", fields: [jobPostId], references: [id], onDelete: SetNull)
  assignedAdmin   User?                          @relation("AssistedHiringAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  matchedProfiles AssistedHiringMatchedProfile[]

  @@index([employerId, status])
  @@index([status, startedAt])
  @@index([assignedAdminId])
  @@index([orderId])
}

/**
 * One row per CV the admin team selects for a request — typically 4-5.
 */
model AssistedHiringMatchedProfile {
  id                  String   @id @default(uuid())
  requestId           String
  candidateUserId     String?
  candidateName       String
  candidateHeadline   String?
  candidateExperience String?
  candidateLocation   String?
  resumeUrl           String?
  notes               String?
  createdAt           DateTime @default(now())

  request   AssistedHiringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  candidate User?                 @relation("AssistedHiringCandidate", fields: [candidateUserId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

// --- Vendor Connect (recruitment-partner role) ---

enum VendorLeadStatus {
  PENDING
  RESPONDED
  ACCEPTED
  DECLINED
  EXPIRED
}

model VendorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  businessName    String
  slug            String   @unique
  description     String?
  logo            String?
  website         String?
  contactEmail    String
  contactPhone    String
  services        String[] @default([]) // e.g. ["IT staffing","Permanent","Contract"]
  industries      String[] @default([])
  locations       String[] @default([])
  yearsInBusiness Int?
  teamSize        Int?
  isPublic        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User           @relation("VendorOwner", fields: [userId], references: [id], onDelete: Cascade)
  leads   VendorLead[]
  reviews VendorReview[]

  @@index([userId])
  @@index([slug])
  @@index([isPublic])
}

model VendorReview {
  id              String   @id @default(uuid())
  vendorProfileId String
  reviewerId      String // employer userId who left the review
  rating          Int // 1-5
  text            String?
  /**
   * True when the reviewer had a RESPONDED/ACCEPTED VendorLead with this vendor.
   */
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  reviewer      User          @relation("VendorReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([vendorProfileId, reviewerId])
  @@index([vendorProfileId, rating])
  @@index([reviewerId])
}

model VendorLead {
  id              String           @id @default(uuid())
  vendorProfileId String
  jobPostId       String? // populated when lead routed from a JobPost
  employerId      String // who is asking
  requirementText String // free-text describing the role / hiring need
  contactEmail    String
  contactPhone    String?
  status          VendorLeadStatus @default(PENDING)
  responseText    String?
  respondedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  jobPost       JobPost?      @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  employer      User          @relation("VendorLeadEmployer", fields: [employerId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId, status])
  @@index([employerId])
  @@index([jobPostId])
}

// --- Candidate Lists/Folders (Employer organization) ---

model CandidateList {
  id          String   @id @default(uuid())
  employerId  String
  name        String
  description String?
  color       String?  @default("#6366F1")
  icon        String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer User                  @relation("EmployerCandidateLists", fields: [employerId], references: [id], onDelete: Cascade)
  members  CandidateListMember[]

  @@index([employerId])
}

model CandidateListMember {
  id            String   @id @default(uuid())
  listId        String
  candidateId   String
  addedAt       DateTime @default(now())
  notes         String?
  addedByUserId String

  list      CandidateList @relation(fields: [listId], references: [id], onDelete: Cascade)
  candidate User          @relation("CandidateInLists", fields: [candidateId], references: [id], onDelete: Cascade)
  addedBy   User          @relation("ListMembersAddedBy", fields: [addedByUserId], references: [id], onDelete: Cascade)

  @@unique([listId, candidateId])
  @@index([listId])
  @@index([candidateId])
}

// --- Saved Searches ---

model SavedSearch {
  id         String   @id @default(uuid())
  userId     String
  name       String
  searchType String // "CANDIDATE_SEARCH" or "JOB_SEARCH"
  filters    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchType])
}

// ─────────────────────────────────────────────────────────────────────
// Search history — distinct from SavedSearch in that it auto-records
// every search the user (or guest) runs, supports a "new jobs since
// last seen" delta count for chip badges, and dedups by deterministic
// `filtersHash`.
//
// Powers the homepage hero chips, the listing-page chip strip, and
// the candidate dashboard "recent searches" widget.
// ─────────────────────────────────────────────────────────────────────
enum SearchHistoryType {
  JOB
  CANDIDATE
  COMPANY
}

// ─────────────────────────────────────────────────────────────────────
// Curated listings — drive the public-search header mega-menu, footer
// mega-section, and SEO landing pages (`/jobs/category/it-software`,
// `/jobs/in/delhi`, etc.). Editable via super-admin (out-of-scope for
// this delivery — model is ready). Seeded with ~150 entries on first
// deploy via `scripts/seed-curated-listings.ts`.
// ─────────────────────────────────────────────────────────────────────
enum CuratedType {
  JOB_CATEGORY // "IT Jobs", "Sales Jobs"
  JOB_DEMAND // "Fresher Jobs", "Remote Jobs"
  JOB_LOCATION // "Jobs in Delhi"
  JOB_QUALIFICATION // "10th Pass Jobs", "BTech Jobs"
  JOB_DEPARTMENT // "Engineering Jobs", "Operations Jobs"
  JOB_COLLECTION // "Top Companies Hiring", "Trending Now"
  COMPANY_CATEGORY // "Unicorn", "MNC", "Startup"
  COMPANY_COLLECTION // "Top Companies", "IT Companies"
}

model CuratedListing {
  id              String      @id @default(uuid())
  slug            String      @unique
  type            CuratedType
  label           String
  // Filter preset applied to the search backend when this slug is
  // visited. Shape mirrors the search-API filter blob for drop-in
  // application.
  filterPreset    Json
  iconKey         String?
  displayOrder    Int         @default(0)
  isFeatured      Boolean     @default(false)
  metaTitle       String?
  metaDescription String?
  heroH1          String?
  heroSubtitle    String?
  isPublic        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([type, isPublic, displayOrder])
  @@index([slug])
}

// --- Company Follow (candidates following companies) ---
//
// One row per (candidate, company) pair. Candidates browse the public
// company directory and click "Follow"; employers see follower counts
// + a list of their followers in the dashboard.
//
// Fan-out notifications (new job from a followed company) read this
// table via the BullMQ follower-notify worker.
model CompanyFollow {
  id        String   @id @default(uuid())
  /**
   * The candidate who's following.
   */
  userId    String
  /**
   * The CompanyProfile being followed (NOT the employer userId — the
   * profile id, so we can join cleanly to JobPost.companyId).
   */
  companyId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}

model SearchHistory {
  id           String            @id @default(uuid())
  // Either userId (auth) or sessionId (guest) is set; never both null.
  userId       String?
  sessionId    String?
  searchType   SearchHistoryType
  // Canonical filter blob, sorted + normalised so equivalent searches
  // share the same hash regardless of input ordering.
  filters      Json
  // SHA-256 of the canonical JSON; used for the (user/session, type, hash)
  // unique tuple so re-running the same search increments `hits` instead
  // of inserting a duplicate row.
  filtersHash  String
  query        String?
  location     String?
  resultsCount Int               @default(0)
  // When the user last actually ran or viewed this search. Used to
  // compute "new jobs since" deltas — counts JobPost.createdAt > lastSeenAt.
  lastSeenAt   DateTime          @default(now())
  hits         Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, searchType, filtersHash], name: "user_unique_search")
  @@unique([sessionId, searchType, filtersHash], name: "session_unique_search")
  @@index([userId, lastSeenAt])
  @@index([sessionId, lastSeenAt])
  @@index([searchType, lastSeenAt])
}

// --- Profile Views ---

model ProfileView {
  id            String   @id @default(uuid())
  viewerId      String
  profileUserId String
  viewType      String // "CANDIDATE_PROFILE" or "COMPANY_PROFILE"
  createdAt     DateTime @default(now())

  viewer      User @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profileUser User @relation("ProfileViewed", fields: [profileUserId], references: [id], onDelete: Cascade)

  @@index([profileUserId, createdAt])
  @@index([viewerId])
}

// --- Notification System ---

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  category  String? // e.g., "job_match", "application_update", "security"
  link      String? // Deep link to relevant page
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json? // Extra structured data
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// --- Form Drafts ---

enum FormDraftType {
  CANDIDATE_PROFILE
  JOB_SEARCH_PREFERENCES
  CANDIDATE_SEARCH
  JOB_POSTING
  EMPLOYER_PROFILE
}

model FormDraft {
  id        String        @id @default(uuid())
  userId    String
  formType  FormDraftType
  data      Json // The draft form data
  name      String? // Optional user-given name for the draft
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, formType, name])
  @@index([userId, formType])
}

// --- Push Subscriptions (Web Push VAPID) ---

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Device Tokens (FCM) ---

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String? // "android", "ios", "web"
  deviceName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Job-Candidate Match Notifications (Tracking multi-channel notifications) ---

model JobCandidateMatch {
  id                String    @id @default(uuid())
  jobId             String
  candidateId       String
  matchScore        Float?
  notificationsSent Boolean   @default(false)
  emailSent         Boolean   @default(false)
  smsSent           Boolean   @default(false)
  pushSent          Boolean   @default(false)
  whatsappSent      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  notifiedAt        DateTime?

  job       JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate User    @relation("CandidateMatches", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([notificationsSent])
  @@index([createdAt])
}

// --- System Configuration ---

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// --- WebAuthn Credentials (Passkeys) ---

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[]
  deviceType   String?
  backedUp     Boolean  @default(false)
  friendlyName String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Webhook Endpoints ---

model WebhookEndpoint {
  id              String    @id @default(cuid())
  userId          String
  url             String
  secret          String
  events          String[]
  isActive        Boolean   @default(true)
  description     String?
  failureCount    Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([isActive])
}

// --- Webhook Deliveries ---

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  response   String?
  success    Boolean  @default(false)
  attempt    Int      @default(1)
  error      String?
  createdAt  DateTime @default(now())

  webhook WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isRead])
  @@index([createdAt])
}

// --- Support Ticket System ---

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_REPLY
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  GENERAL
  ACCOUNT
  BILLING
  TECHNICAL
  BUG_REPORT
  FEATURE_REQUEST
  JOB_POSTING
  APPLICATION
  VERIFICATION
  OTHER
}

enum TicketSatisfaction {
  SATISFIED
  NEUTRAL
  NOT_SATISFIED
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  category     TicketCategory @default(GENERAL)

  // Submitter — either a registered user OR a guest
  userId     String?
  guestName  String?
  guestEmail String?

  // Assignment
  assignedToId String?

  // Resolution
  satisfaction        TicketSatisfaction?
  satisfactionComment String?
  resolvedAt          DateTime?
  closedAt            DateTime?
  firstResponseAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User?           @relation("UserTickets", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   TicketMessage[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([ticketNumber])
  @@index([createdAt])
  @@index([category])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String?
  senderType String // USER, ADMIN, SYSTEM, GUEST
  senderName String
  subject    String?
  body       String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// --- Security & Privacy ---

model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  name        String?
  ipAddress   String?
  location    String?
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
}

model LoginLocation {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String
  country   String?
  city      String?
  latitude  Float?
  longitude Float?
  isTrusted Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UserConsent {
  id        String    @id @default(cuid())
  userId    String
  type      String
  version   String
  givenAt   DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// --- MFA Trusted Devices (skip MFA for 30 days) ---

model MfaTrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// --- Job Alerts ---

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
  OFF
}

model JobAlert {
  id             String         @id @default(uuid())
  userId         String
  name           String
  filters        Json
  frequency      AlertFrequency @default(DAILY)
  isActive       Boolean        @default(true)
  lastNotifiedAt DateTime?
  newMatchCount  Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([isActive, frequency])
}

// --- Dismissed Recommendations ---

model DismissedRecommendation {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

// --- Kafka DLQ Messages ---

model KafkaDlqMessage {
  id            String    @id @default(uuid())
  originalTopic String
  partition     Int
  offset        String
  originalValue String?   @db.Text
  error         String?   @db.Text
  stack         String?   @db.Text
  timestamp     DateTime
  replayed      Boolean   @default(false)
  replayedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([originalTopic])
  @@index([replayed])
}

// --- Kafka Event Store (for replay) ---

model KafkaEvent {
  id          String   @id @default(uuid())
  eventType   String
  key         String
  data        String   @db.Text
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([publishedAt])
}

// =====================================================================
// Billing / Payments / Subscriptions / Coupons / Invoices / Entitlements
// =====================================================================
// Razorpay-backed payment system. Webhook is source of truth.
// All amounts stored as integer paise (1 INR = 100 paise) unless noted.
// Migration: edit schema -> hand-roll SQL into prisma/migrations.
// =====================================================================

enum PlanCategory {
  CANDIDATE_PREMIUM
  EMPLOYER_JOB_POST
  EMPLOYER_CV_DATABASE
  EMPLOYER_ASSISTED_HIRING
  VENDOR_CONNECT
  EMPLOYER_CV_ENTERPRISE_CUSTOM
}

