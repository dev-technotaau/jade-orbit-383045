# =============================================================
# WhatsApp Cloud Module — backend
# =============================================================
# Copy to `.env` and fill in. Every key below is declared in
# src/config/env.ts, which validates on boot and exits on failure.
# Nothing else is read — the schema is the complete list.
#
# Strictly required to start: DATABASE_URL, CSRF_SECRET, APP_PASSWORD,
# and a working Meta credential set. Everything else has a default or
# degrades gracefully when unset.

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (REQUIRED) ─────────────────────────────────────
# Point this at a BRAND-NEW database. The module ships no migration
# history — create the schema with `npx prisma db push`.
# The connection the APPLICATION uses.
#
# Plain Postgres (local, or a VM you manage): one URL, port 5432, done.
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_module?schema=public

# The DIRECT connection, used by the Prisma CLI only: db push, migrate, studio.
#
# Leave EMPTY unless DATABASE_URL points at a connection pooler — prisma.config.js
# resolves `DIRECT_URL || DATABASE_URL`, so an unset value falls back correctly.
#
# ── When you DO need it: Supabase, Neon, PgBouncer, RDS Proxy ──
# Managed providers give you two connection strings for the same database:
#
#   pooled   port 6543  transaction mode  -> DATABASE_URL   (the app)
#   direct   port 5432  session mode      -> DIRECT_URL     (the CLI)
#
# The app wants the pooler: it opens and closes connections constantly across
# HTTP handlers, six BullMQ workers and nine crons, and a pooler is what keeps
# that inside the provider's connection cap.
#
# Schema changes must NOT go through it. `db push` and `migrate` issue DDL and
# take Prisma advisory locks, neither of which survives transaction-mode
# pooling — and the failure surfaces as an opaque hang or timeout that reads
# like a network fault rather than a configuration mistake.
#
# Supabase example (both strings are in Project Settings -> Database):
#   DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# `?pgbouncer=true` tells Prisma to stop using prepared statements, which
# transaction-mode pooling cannot support. `connection_limit=1` is right when
# several replicas share one pooler.
#
# URL-encode the password if it contains @ : / ? # [ ] % — otherwise the
# connection string parses wrong and the error blames the host, not the password.
DIRECT_URL=

DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=10

# TLS for the database connection. One of:
#   disable      no encryption — local Postgres only
#   prefer       encrypt if the server offers it
#   require      encrypt, but do NOT verify the server certificate  (default)
#   verify-ca    encrypt + verify the certificate chain
#   verify-full  encrypt + verify the chain AND the hostname
#
# `require` is the default because every managed provider mandates TLS while
# presenting certificates a bare Node client cannot chain-verify without their
# CA bundle. It gives you confidentiality, not authentication of the server —
# so if you can supply a trusted chain, verify-full is strictly better.
DATABASE_SSL_MODE=require

# ── Security (REQUIRED) ─────────────────────────────────────
# Min 32 chars.
CSRF_SECRET=

# The single credential gating this module — min 16 chars.
# There are no accounts or roles: whoever has this can do everything.
# Auth FAILS CLOSED when unset (nothing authenticates).
APP_PASSWORD=

# Label stamped on createdBy / assignedTo / actorUserId audit fields.
OPERATOR_LABEL=operator

# Session generation. Bump to invalidate every outstanding unlock cookie and
# socket immediately, WITHOUT changing APP_PASSWORD (which the whole team knows).
# Use when someone leaves, a device is lost, or a token may have leaked.
SESSION_EPOCH=1

# Absolute session lifetime, in seconds (default 12h = 43200).
# Signed INTO the unlock token, so the SERVER enforces it — the cookie's own
# maxAge is only a hint to the browser. Deliberately absolute rather than idle-
# based: an operator reading a long thread without clicking should not be signed
# out mid-reply.
SESSION_MAX_AGE_SECONDS=43200

# Shared secret proving a request came from the Next.js BFF rather than a
# browser. Must match frontend/.env. Min 32 chars.
BFF_SECRET=

# AES-256-GCM key for at-rest field encryption of consent evidence (opt-in
# provenance, incl. IP + referral) and internal note bodies. 64 hex chars.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty = stored as plaintext. Losing a set key makes existing rows unreadable.
FIELD_ENCRYPTION_KEY=

# ── Branding ────────────────────────────────────────────────
# Shown on the API's HTML pages (root, health, 404) and the OpenAPI docs.
# Keep in sync with the frontend's NEXT_PUBLIC_BRAND_NAME.
BRAND_NAME=TechnoTaau

# ── Meta WhatsApp Cloud API (REQUIRED to send/receive) ──────
# System-user token with whatsapp_business_messaging + _management.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_WABA_ID=
# App ID — used for the resumable-upload session (media header samples).
META_WHATSAPP_APP_ID=
# Verifies the webhook's X-Hub-Signature-256 HMAC.
META_WHATSAPP_APP_SECRET=
# Echoed back during Meta's GET hub.challenge handshake.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v21.0

# ── WhatsApp behaviour ──────────────────────────────────────
# Applied to numbers supplied without a country code.
DEFAULT_COUNTRY_CODE=91
WHATSAPP_OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,CANCEL
WHATSAPP_CAMPAIGN_CONCURRENCY=1
# Estimated per-message cost (paise) — drives campaign cost previews only.
WHATSAPP_PRICE_MARKETING_PAISE=78
WHATSAPP_PRICE_UTILITY_PAISE=30
WHATSAPP_PRICE_AUTH_PAISE=30

# ── Optional: Chatwoot bridge ───────────────────────────────
# Lets a self-hosted Chatwoot send outbound through this module.
WHATSAPP_CHATWOOT_BRIDGE_ENABLED=false
CHATWOOT_BASE_URL=
CHATWOOT_BRIDGE_SECRET=
CHATWOOT_INBOUND_PHONE=

# ── Redis (queues, cache, Socket.IO fan-out) ────────────────
# REDIS_URL wins when set; otherwise HOST/PORT are used.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_ENABLED=true

# ── BullMQ ──────────────────────────────────────────────────
BULLMQ_DEFAULT_JOB_OPTIONS_ATTEMPTS=3
BULLMQ_DEFAULT_JOB_OPTIONS_BACKOFF=1000
BULLMQ_REMOVE_ON_COMPLETE=100
BULLMQ_REMOVE_ON_FAIL=500
BULLMQ_WHATSAPP_CONCURRENCY=10
BULLMQ_WEBHOOK_CONCURRENCY=5
BULLMQ_SCHEDULER_CONCURRENCY=2

# ── CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*

# ── Optional: object storage for WhatsApp media ─────────────
# Cloudflare R2. The client is a plain S3 client, so any S3-compatible
# provider works if you also change the endpoint in src/config/r2.ts.
# Leave unset to keep media only on Meta's servers (they expire).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL. When set it is added to the backend's CSP img-src.
R2_PUBLIC_URL=

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Applies to POST /unlock.
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=30

# ── Logging ─────────────────────────────────────────────────
# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
# Optional: ship Winston logs to a collector (Loki, Datadog, …).
LOG_AGGREGATION_URL=
LOG_AGGREGATION_TOKEN=

# Number of reverse proxies in front of Express. Decides what req.ip resolves to,
# and therefore what the per-IP rate limiter buckets on. Verify after deploying
# with GET /api/v1/unlock/whoami — `ip` should be the operator's real address.
TRUST_PROXY_HOPS=1

# Hard deadline (ms) for graceful shutdown before the process force-exits.
# Must be under the orchestrator's termination grace period.
SHUTDOWN_TIMEOUT_MS=25000

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
# Bot protection in front of the app password. REQUIRED in production — the
# server refuses to boot without it, and the middleware fails closed.
#
# Get keys at https://dash.cloudflare.com → Turnstile. The matching site key
# goes in the frontend as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
#
# For local development, Cloudflare's official always-passes test pair:
#   secret: 1x0000000000000000000000000000000AA
#   site:   1x00000000000000000000AA
# (2x... variants always fail, for testing the rejection path.)
CF_TURNSTILE_SECRET_KEY=

# ── MFA ─────────────────────────────────────────────────────────────────────
# TOTP is stored encrypted, so FIELD_ENCRYPTION_KEY (above) is REQUIRED before
# MFA can be enabled — enrolment refuses rather than store a plaintext seed.
# The authenticator's issuer label comes from BRAND_NAME.

# Allow the X-App-Password header to authenticate when MFA is enabled.
# Default false: the header is compared against APP_PASSWORD directly, so leaving
# it open would let anyone holding the password reach every operator route
# without ever presenting a second factor. Set true only if a script genuinely
# needs single-factor API access.
ALLOW_PASSWORD_HEADER_WITH_MFA=false
